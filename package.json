{
  "name": "us-tax-advantaged-params",
  "version": "0.2.0",
  "description": "Historical and current U.S. tax-advantaged account parameters. Retirement accounts are covered today: contribution limits, phase-outs, shared-limit allocation, and Roth-conversion tax effects.",
  "type": "module",
  "main": "./dist/cjs/USTaxAdvantagedParams.js",
  "module": "./dist/esm/USTaxAdvantagedParams.js",
  "types": "./dist/types/USTaxAdvantagedParams.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/USTaxAdvantagedParams.d.ts",
        "default": "./dist/esm/USTaxAdvantagedParams.js"
      },
      "require": {
        "types": "./dist/types/USTaxAdvantagedParams.d.cts",
        "default": "./dist/cjs/USTaxAdvantagedParams.js"
      },
      "default": "./dist/esm/USTaxAdvantagedParams.js"
    },
    "./data/retirement-parameters.json": "./data/retirement-parameters.json",
    "./data/hsa-parameters.json": "./data/hsa-parameters.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data/retirement-parameters.json",
    "data/hsa-parameters.json",
    "README.md",
    "LICENSE",
    "SOURCES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:manifests": "node scripts/validate-manifests.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run generate:check && npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json && node scripts/finalize-build.mjs",
    "test:compile": "node scripts/clean-tests.mjs && tsc -p tsconfig.tests.json",
    "test:ts": "npm run test:compile && node --test dist-tests/tests/USTaxAdvantagedParams.test.js dist-tests/tests/conformance.test.js",
    "test:php": "php php/tests/USTaxAdvantagedParamsTest.php && php php/tests/ConformanceVectorsTest.php",
    "test:parity": "npm run build && node scripts/check-parity.mjs",
    "test": "npm run test:ts && npm run test:php && npm run test:parity",
    "check:types": "mkdir -p dist-tests && npm pack --ignore-scripts --no-dry-run --pack-destination dist-tests >/dev/null && attw dist-tests/us-tax-advantaged-params-$npm_package_version.tgz",
    "verify": "npm run validate:data && npm run validate:evidence && npm run generate:check && npm run validate:manifests && npm run typecheck && npm run test:ts && npm run test:php && npm run build && node scripts/smoke-imports.mjs && npm run check:types && node scripts/check-parity.mjs && node scripts/validate-manifests.mjs --built",
    "validate:release": "node scripts/validate-release.mjs",
    "release:archives": "node scripts/create-release-archives.mjs",
    "prepack": "npm run verify",
    "validate:evidence": "node scripts/verify-evidence.mjs",
    "validate:evidence:retirement": "node scripts/verify-evidence.mjs retirement-limits",
    "validate:evidence:hsa": "node scripts/verify-evidence.mjs hsa-limits"
  },
  "keywords": [
    "tax-advantaged",
    "tax-advantaged-accounts",
    "retirement",
    "retirement-accounts",
    "401k",
    "403b",
    "457b",
    "ira",
    "roth-ira",
    "sep-ira",
    "simple-ira",
    "tax",
    "tax-calculator"
  ],
  "author": "Ben Herila",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bherila/us-tax-advantaged-params.git"
  },
  "bugs": {
    "url": "https://github.com/bherila/us-tax-advantaged-params/issues"
  },
  "homepage": "https://github.com/bherila/us-tax-advantaged-params#readme",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  }
}
