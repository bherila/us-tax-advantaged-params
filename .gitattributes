* text=auto eol=lf
*.php text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf

/.gitignore export-ignore
/.gitattributes export-ignore
/.github export-ignore
/dist export-ignore
/dist-tests export-ignore
/node_modules export-ignore
/tests export-ignore
/scripts export-ignore
/src export-ignore
/data/conformance-vectors.json export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/tsconfig.json export-ignore
/tsconfig.*.json export-ignore
/validation-status.json export-ignore
/VALIDATION.md export-ignore
/RELEASE_STATUS.md export-ignore

# The evidence corpus backs the published figures but is not part of either
# distributed artifact. npm ships via the `files` allowlist in package.json,
# which already excludes it; Composer ships everything not listed here.
/evidence export-ignore

# The notices under evidence/ are already-compressed binaries; excluding them
# from text normalisation and diffing keeps them byte-identical to what was
# downloaded, which is what SHA256SUMS.txt attests.
/evidence/**/*.pdf -text -diff
# Primary-law HTML captures are hash-pinned source artifacts too. Preserve their
# upstream line endings and whitespace exactly, just like the PDF notices.
/evidence/**/*.html -text -diff
